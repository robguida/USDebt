# Vendored third-party files are kept byte-for-byte so their published
# checksums still match after a checkout on any OS.
src/Public/lib/** -text

# Checksum files are checked with sha256sum -c, which needs plain LF lines.
*.sha256 text eol=lf

# composer.phar is a binary PHP archive. Its SHA-256 is pinned in
# composer.phar.sha256, so it must never be touched by line-ending conversion.
composer.phar binary

# Self-hosted fonts for the share card (DejaVu Sans 2.37). Binary, byte-exact,
# so their pinned checksums still match.
src/lib/Assets/fonts/*.ttf binary
src/lib/Assets/fonts/DejaVu-LICENSE.txt -text
